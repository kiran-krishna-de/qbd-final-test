config {
  type: "table",
  schema: dataform.projectConfig.vars.gold_dataset,
  name: "kpi_09_cash_flow",
  tags: ["gold", "kpi"],
  description: "KPI 9: Monthly cash inflows vs outflows from transaction ledger"
}

WITH cash_transactions AS (
  SELECT
    DATE_TRUNC(CAST(transaction_date AS DATETIME), MONTH)           AS flow_month,
    transaction_type,
    account_name,
    SUM(amount)                                   AS net_amount,
    SUM(CASE WHEN amount > 0 THEN amount ELSE 0 END) AS inflow,
    SUM(CASE WHEN amount < 0 THEN ABS(amount) ELSE 0 END) AS outflow,
    COUNT(*)                                      AS transaction_count
  FROM ${ref("qdb_silver", "fct_transactions")}
  GROUP BY 1,2,3
),
transfers AS (
  SELECT
    DATE_TRUNC(CAST(t.transactionDate AS DATETIME), MONTH)          AS flow_month,
    'transfer'                                    AS transaction_type,
    t.sourceAccount__fullName                     AS account_name,
    -SUM(SAFE_CAST(t.amount AS NUMERIC))          AS net_amount,
    0                                             AS inflow,
    SUM(SAFE_CAST(t.amount AS NUMERIC))           AS outflow,
    COUNT(*)                                      AS transaction_count
  FROM ${ref("qdb_bronze", "transfers")} t
  WHERE t.id IS NOT NULL
  GROUP BY 1,2,3
)
SELECT
  flow_month,
  transaction_type,
  account_name,
  net_amount,
  inflow,
  outflow,
  inflow - outflow                                AS net_cash_flow,
  transaction_count,
  CURRENT_TIMESTAMP()                             AS _refreshed_at
FROM cash_transactions
UNION ALL
SELECT
  flow_month,
  transaction_type,
  account_name,
  net_amount,
  inflow,
  outflow,
  inflow - outflow,
  transaction_count,
  CURRENT_TIMESTAMP()
FROM transfers
ORDER BY flow_month DESC
