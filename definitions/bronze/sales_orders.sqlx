config {
  type: "incremental",
  schema: "qdb_bronze",
  tags: ["bronze", "sales_orders"],
  uniqueKey: ["id","lines__id"],
  description: "Flat sales orders table parsed from raw_payload JSON. Nested fields use __ separator."
}

js {
  const { buildJsonSelect } = require("../../includes/helpers.js");
  const { inc } = require("../../includes/helpers.js");

  const columns = [
    // Top-level
    "id",
    "refNumber",
    "transactionDate",
    "dueDate",
    "shippingDate",
    "createdAt",
    "updatedAt",
    "objectType",
    "revisionNumber",
    "memo",
    "subtotal",
    "salesTaxTotal",
    "salesTaxPercentage",
    "totalAmount",

    "isFullyInvoiced",
    "isManuallyClosed",
    "isQueuedForEmail",
    "isQueuedForPrint",

    // Customer
    "customer__fullName",
    "customer__id",

    // Document Template
    "documentTemplate__fullName",
    "documentTemplate__id",

    // Billing Address
    "billingAddress__line1",
    "billingAddress__line2",
    "billingAddress__city",
    "billingAddress__state",
    "billingAddress__postalCode",
    "billingAddress__country",

    // Shipping Address
    "shippingAddress__line1",
    "shippingAddress__line2",
    "shippingAddress__city",
    "shippingAddress__state",
    "shippingAddress__postalCode",
    "shippingAddress__country",

    // Sales Tax
    "salesTaxCode__fullName",
    "salesTaxCode__id",

    "salesTaxItem__fullName",
    "salesTaxItem__id",

    // Lines (array → UNNEST)
    "lines__id",
    "lines__description",
    "lines__amount",
    "lines__rate",
    "lines__quantity",
    "lines__quantityInvoiced",
    "lines__isManuallyClosed",

    "lines__item__fullName",
    "lines__item__id",

    "lines__salesTaxCode__fullName",
    "lines__salesTaxCode__id"
  ];

  const select_sql = buildJsonSelect(columns);
}

WITH base AS (
  SELECT
    raw_payload,
    _extracted_at,
    JSON_QUERY_ARRAY(raw_payload, '$.lines') AS lines
  FROM ${ref("qdb_new","sales_orders")}
  WHERE JSON_VALUE(raw_payload, '$.id') IS NOT NULL
  ${inc(ctx)}
),

flattened AS (
  SELECT
    raw_payload,
    _extracted_at,
    l AS lines
  FROM base,
  UNNEST(IFNULL(lines, [])) AS l
)

SELECT
  ${select_sql},
  _extracted_at
FROM flattened