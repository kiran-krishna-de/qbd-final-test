config {
  type: "incremental",
  schema: "qdb_bronze",
  tags: ["bronze", "non_inventory_items"],
  uniqueKey: ["id"],
  description: "Flat non-inventory items table parsed from raw_payload JSON. Nested fields use __ separator."
}

js {
  const { buildJsonSelect } = require("../../includes/helpers.js");
  const { inc } = require("../../includes/helpers.js");

  const columns = [
    // Top-level
    "id",
    "name",
    "fullName",
    "createdAt",
    "updatedAt",
    "objectType",
    "revisionNumber",
    "isActive",
    "barcode",
    "sku",
    "sublevel",

    // Parent
    "parent",

    // Sales & Purchase Details (nested object)
    "salesAndPurchaseDetails__purchaseCost",
    "salesAndPurchaseDetails__purchaseDescription",
    "salesAndPurchaseDetails__salesPrice",
    "salesAndPurchaseDetails__salesDescription",

    "salesAndPurchaseDetails__expenseAccount__fullName",
    "salesAndPurchaseDetails__expenseAccount__id",

    "salesAndPurchaseDetails__incomeAccount__fullName",
    "salesAndPurchaseDetails__incomeAccount__id",

    "salesAndPurchaseDetails__preferredVendor__fullName",
    "salesAndPurchaseDetails__preferredVendor__id",

    // Sales Tax Code
    "salesTaxCode__fullName",
    "salesTaxCode__id"
  ];

  const select_sql = buildJsonSelect(columns);
}

SELECT
  ${select_sql},
  _extracted_at
FROM ${ref("qdb_new","non_inventory_items")}
WHERE JSON_VALUE(raw_payload, '$.id') IS NOT NULL
${inc(ctx)}