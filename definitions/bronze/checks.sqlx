config {
  type: "incremental",
  schema: "qdb_bronze",
  tags: ["bronze", "checks"],
  uniqueKey: ["id","expenseLines__id"],
  description: "Flat checks table parsed from raw_payload JSON. Nested fields use __ separator."
}

js {
  const { buildJsonSelect } = require("../../includes/helpers.js");
  const { inc } = require("../../includes/helpers.js");

  const columns = [
    // Top-level
    "id",
    "refNumber",
    "transactionDate",
    "createdAt",
    "updatedAt",
    "amount",
    "currency",
    "objectType",
    "revisionNumber",

    // Bank account
    "bankAccount__fullName",
    "bankAccount__id",

    // Payee
    "payee__fullName",
    "payee__id",

    // Address
    "address__line1",
    "address__city",
    "address__state",
    "address__country",

    // Expense line fields (from UNNEST)
    "expenseLines__id",
    "expenseLines__amount",
    "expenseLines__account__fullName",
    "expenseLines__account__id",
    "expenseLines__class__fullName",
    "expenseLines__class__id",
    "expenseLines__payee__fullName",
    "expenseLines__payee__id"
  ];

  const select_sql = buildJsonSelect(columns);
}

WITH base AS (
  SELECT
    raw_payload,
    _extracted_at,
    JSON_QUERY_ARRAY(raw_payload, '$.expenseLines') AS expenseLines
  FROM ${ref("qdb_new","checks")}
  WHERE JSON_VALUE(raw_payload, '$.id') IS NOT NULL
  ${inc(ctx)}
),

flattened AS (
  SELECT
    raw_payload,
    _extracted_at,
    el AS expenseLines
  FROM base,
  UNNEST(expenseLines) AS el
)

SELECT
  ${select_sql},
  _extracted_at
FROM flattened