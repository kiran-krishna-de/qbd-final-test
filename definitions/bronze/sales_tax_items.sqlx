config {
  type: "incremental",
  schema: "bronze",
  tags: ["bronze", "sales_tax_items"],
  uniqueKey: ["id"],
  description: "Flat sales tax items table parsed from raw_payload JSON. Nested fields use __ separator."
}

js {
  const { buildJsonSelect } = require("../../includes/helpers.js");

  const { inc } = require("../../includes/helpers.js");

  const columns = [
    "barcode",
    "class",
    "createdAt",
    "description",
    "externalId",
    "id",
    "isActive",
    "name",
    "objectType",
    "revisionNumber",
    "salesTaxReturnLine",
    "taxRate",
    "updatedAt",

    // Nested: taxVendor
    "taxVendor__id",
    "taxVendor__fullName"
  ];

  const select_sql = buildJsonSelect(columns);

  const raw_dataset = dataform.projectConfig.vars.raw_dataset;
}

SELECT
  ${select_sql},
  _extracted_at
FROM ${ref(raw_dataset,"sales_tax_items")}
WHERE JSON_VALUE(raw_payload, '$.id') IS NOT NULL
${inc(ctx)}