config {
  type: "incremental",
  schema: "bronze",
  tags: ["bronze", "payment_methods"],
  uniqueKey: ["id"],
  description: "Flat payment methods table parsed from raw_payload JSON."
}

js {
  const { buildJsonSelect } = require("../../includes/helpers.js");

  const { inc } = require("../../includes/helpers.js");

  const columns = [
    "createdAt",
    "id",
    "isActive",
    "name",
    "objectType",
    "paymentMethodType",
    "revisionNumber",
    "updatedAt"
  ];

  const select_sql = buildJsonSelect(columns);

  const raw_dataset = dataform.projectConfig.vars.raw_dataset;
}

SELECT
  ${select_sql},
  _extracted_at
FROM ${ref(raw_dataset,"payment_methods")}
WHERE JSON_VALUE(raw_payload, '$.id') IS NOT NULL
${inc(ctx)}