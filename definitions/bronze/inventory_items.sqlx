config {
  type: "incremental",
  schema: dataform.projectConfig.vars.bronze_dataset,
  tags: ["bronze", "inventory_items"],
  uniqueKey: ["id"],
  description: "Flat inventory items table parsed from raw_payload JSON. Nested fields use __ separator."
}

js {
  const { buildJsonSelect } = require("../../includes/helpers.js");
  
  const { inc } = require("../../includes/helpers.js");

  const columns = [
    "averageCost",
    "barcode",
    "createdAt",
    "externalId",
    "fullName",
    "id",
    "isActive",
    "maximumQuantityOnHand",
    "name",
    "objectType",
    "parent",
    "purchaseCost",
    "purchaseDescription",
    "purchaseTaxCode",
    "quantityOnHand",
    "quantityOnPurchaseOrder",
    "quantityOnSalesOrder",
    "reorderPoint",
    "revisionNumber",
    "salesDescription",
    "salesPrice",
    "sku",
    "sublevel",
    "unitOfMeasureSet",
    "updatedAt",

    // Nested: assetAccount
    "assetAccount__id",
    "assetAccount__fullName",

    // Nested: cogsAccount
    "cogsAccount__id",
    "cogsAccount__fullName",

    // Nested: incomeAccount
    "incomeAccount__id",
    "incomeAccount__fullName",

    // Nested: preferredVendor
    "preferredVendor__id",
    "preferredVendor__fullName",

    // Nested: salesTaxCode
    "salesTaxCode__id",
    "salesTaxCode__fullName",

    // class (nullable but included for schema consistency)
    "class"
  ];

  const select_sql = buildJsonSelect(columns);
  
  const raw_dataset = dataform.projectConfig.vars.raw_dataset;
}

SELECT
  ${select_sql},
  _extracted_at
FROM ${ref(raw_dataset,"inventory_items")}
WHERE JSON_VALUE(raw_payload, '$.id') IS NOT NULL
${inc(ctx)}