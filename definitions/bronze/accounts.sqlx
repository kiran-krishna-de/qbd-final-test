config {
  type: "incremental",
  schema: "qdb_bronze",
  tags: ["bronze", "accounts"],
  uniqueKey: ["accountNumber","id"],
  description: "Flat accounts table parsed from raw_payload JSON. Nested fields use __ separator."
}

js {
  const { buildJsonSelect } = require("../../includes/helpers.js");

  const { inc } = require("../../includes/helpers.js");

  // Flat fields — single underscore in name is preserved as-is in the JSON path
  // Nested fields — use double underscore (__) to map to dot notation in JSON
  //   e.g. taxLineDetails__taxLineId → JSON_VALUE(raw_payload, '$.taxLineDetails.taxLineId')
  const columns = [
    "accountNumber",
    "accountType",
    "balance",
    "bankAccountNumber",
    "cashFlowClassification",
    "createdAt",
    "currency",
    "description",
    "fullName",
    "id",
    "isActive",
    "isTaxAccount",
    "name",
    "objectType",
    "parent",
    "revisionNumber",
    "salesTaxCode",
    "specialAccountType",
    "sublevel",
    "taxLineDetails__taxLineId",
    "taxLineDetails__taxLineName",
    "totalBalance",
    "updatedAt"
  ];

  const select_sql = buildJsonSelect(columns);
}

SELECT
  ${select_sql},
  _extracted_at
FROM ${ref("qdb_new","accounts")}
WHERE JSON_VALUE(raw_payload, '$.id') IS NOT NULL
${inc(ctx)}