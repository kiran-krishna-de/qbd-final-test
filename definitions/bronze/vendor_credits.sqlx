config {
  type: "incremental",
  schema: "qdb_bronze",
  tags: ["bronze", "vendor_credits"],
  uniqueKey: ["id","itemLines__id"],
  description: "Flat vendor credits table parsed from raw_payload JSON. Nested fields use __ separator."
}

js {
  const { buildJsonSelect } = require("../../includes/helpers.js");
  const { inc } = require("../../includes/helpers.js");

  const columns = [
    // Top-level
    "id",
    "refNumber",
    "transactionDate",
    "createdAt",
    "updatedAt",
    "objectType",
    "revisionNumber",
    "memo",
    "creditAmount",
    "openAmount",

    // Vendor
    "vendor__fullName",
    "vendor__id",

    // Payables account
    "payablesAccount__fullName",
    "payablesAccount__id",

    // Currency fields
    "currency",
    "exchangeRate",
    "creditAmountInHomeCurrency",

    // Item lines (UNNEST)
    "itemLines__id",
    "itemLines__description",
    "itemLines__amount",
    "itemLines__cost",
    "itemLines__quantity",
    "itemLines__billingStatus",

    "itemLines__class__fullName",
    "itemLines__class__id",

    "itemLines__item__fullName",
    "itemLines__item__id",

    "itemLines__customer__fullName",
    "itemLines__customer__id"
  ];

  const select_sql = buildJsonSelect(columns);
}

WITH base AS (
  SELECT
    raw_payload,
    _extracted_at,
    JSON_QUERY_ARRAY(raw_payload, '$.itemLines') AS itemLines
  FROM ${ref("qdb_new","vendor_credits")}
  WHERE JSON_VALUE(raw_payload, '$.id') IS NOT NULL
  ${inc(ctx)}
),

flattened AS (
  SELECT
    raw_payload,
    _extracted_at,
    l AS itemLines
  FROM base,
  UNNEST(IFNULL(itemLines, [])) AS l
)

SELECT
  ${select_sql},
  _extracted_at
FROM flattened