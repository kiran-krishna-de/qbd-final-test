config {
  type: "incremental",
  schema: "bronze",
  tags: ["bronze", "journal_entries"],
  uniqueKey: ["id"],
  description: "Flat journal entries table parsed from raw_payload JSON. Nested fields use __ separator."
}

js {
  const { buildJsonSelect } = require("../../includes/helpers.js");

  const { inc } = require("../../includes/helpers.js");

  const columns = [
    "areAmountsEnteredInHomeCurrency",
    "createdAt",
    "currency",
    "exchangeRate",
    "externalId",
    "id",
    "isAdjustment",
    "isHomeCurrencyAdjustment",
    "objectType",
    "refNumber",
    "revisionNumber",
    "transactionDate",
    "updatedAt"
  ];

  const select_sql = buildJsonSelect(columns);

  const raw_dataset = dataform.projectConfig.vars.raw_dataset;
}

SELECT
  ${select_sql},
  _extracted_at
FROM ${ref(raw_dataset,"journal_entries")}
WHERE JSON_VALUE(raw_payload, '$.id') IS NOT NULL
${inc(ctx)}