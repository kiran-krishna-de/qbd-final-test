config {
  type: "table",
  schema: dataform.projectConfig.vars.bronze_dataset,
  tags: ["bronze", "account_tax_lines"],
  description: "Flat tax line details parsed from raw_payload JSON."
}

js {
  const { buildJsonSelect } = require("../../includes/helpers.js");
  
  const { inc } = require("../../includes/helpers.js");

  const columns = [
    "taxLineId",
    "taxLineName"
  ];

  const select_sql = buildJsonSelect(columns);

  const raw_dataset = dataform.projectConfig.vars.raw_dataset;
}

SELECT
  ${select_sql},
  _extracted_at
FROM ${ref(raw_dataset,"account_tax_lines")}
WHERE JSON_VALUE(raw_payload, '$.taxLineId') IS NOT NULL
${inc(ctx)}

