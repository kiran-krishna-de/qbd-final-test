config {
  type: "incremental",
  schema: "qdb_bronze",
  tags: ["bronze", "transfers"],
  uniqueKey: ["id"],
  description: "Flat transfers table parsed from raw_payload JSON. Nested fields use __ separator."
}

js {
  const { buildJsonSelect } = require("../../includes/helpers.js");
  const { inc } = require("../../includes/helpers.js");

  const columns = [
    // Top-level
    "id",
    "amount",
    "memo",
    "createdAt",
    "updatedAt",
    "transactionDate",
    "objectType",
    "revisionNumber",

    // Class (nullable)
    "class__fullName",
    "class__id",

    // Source account
    "sourceAccount__fullName",
    "sourceAccount__id",

    // Target account
    "targetAccount__fullName",
    "targetAccount__id",

    // Balances
    "sourceAccountBalance",
    "targetAccountBalance"
  ];

  const select_sql = buildJsonSelect(columns);
}

SELECT
  ${select_sql},
  _extracted_at
FROM ${ref("qdb_new","transfers")}
WHERE JSON_VALUE(raw_payload, '$.id') IS NOT NULL
${inc(ctx)}