config {
  type: "incremental",
  schema: "bronze",
  tags: ["bronze", "price_levels"],
  uniqueKey: ["id"],
  description: "Flat price levels table parsed from raw_payload JSON. Nested fields use __ separator."
}

js {
  const { buildJsonSelect } = require("../../includes/helpers.js");
  const { inc } = require("../../includes/helpers.js");

  const columns = [
    // Top-level
    "id",
    "name",
    "createdAt",
    "updatedAt",
    "objectType",
    "revisionNumber",
    "isActive",
    "currency",

    // Price level specific
    "priceLevelType",
    "fixedPercentage"
  ];

  const select_sql = buildJsonSelect(columns);

  const raw_dataset = dataform.projectConfig.vars.raw_dataset;
}

SELECT
  ${select_sql},
  _extracted_at
FROM ${ref(raw_dataset,"price_levels")}
WHERE JSON_VALUE(raw_payload, '$.id') IS NOT NULL
${inc(ctx)}