config {
  type: "incremental",
  schema: "bronze",
  tags: ["bronze", "classes"],
  uniqueKey: ["id"],
  description: "Flat classes table parsed from raw_payload JSON. Nested fields use __ separator."
}

js {
  const { buildJsonSelect } = require("../../includes/helpers.js");

  const { inc } = require("../../includes/helpers.js");

  // Flat fields — no nested structure in this JSON
  const columns = [
    "createdAt",
    "fullName",
    "id",
    "isActive",
    "name",
    "objectType",
    "parent",
    "revisionNumber",
    "sublevel",
    "updatedAt"
  ];

  const select_sql = buildJsonSelect(columns);

  const raw_dataset = dataform.projectConfig.vars.raw_dataset;
}

SELECT
  ${select_sql},
  _extracted_at
FROM ${ref(raw_dataset,"classes")}
WHERE JSON_VALUE(raw_payload, '$.id') IS NOT NULL
${inc(ctx)}