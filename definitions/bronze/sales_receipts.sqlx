config {
  type: "incremental",
  schema: "bronze",
  tags: ["bronze", "sales_receipts"],
  uniqueKey: ["id","lines__id"],
  description: "Flat sales receipts table parsed from raw_payload JSON. Nested fields use __ separator."
}

js {
  const { buildJsonSelect } = require("../../includes/helpers.js");
  const { inc } = require("../../includes/helpers.js");

  const columns = [
    // Top-level
    "id",
    "refNumber",
    "checkNumber",
    "transactionDate",
    "dueDate",
    "shippingDate",
    "createdAt",
    "updatedAt",
    "objectType",
    "revisionNumber",
    "memo",
    "subtotal",
    "salesTaxTotal",
    "salesTaxPercentage",
    "totalAmount",

    "isPending",
    "isQueuedForEmail",
    "isQueuedForPrint",

    // Customer
    "customer__fullName",
    "customer__id",

    // Class
    "class__fullName",
    "class__id",

    // Payment Method
    "paymentMethod__fullName",
    "paymentMethod__id",

    // Deposit Account
    "depositToAccount__fullName",
    "depositToAccount__id",

    // Document Template
    "documentTemplate__fullName",
    "documentTemplate__id",

    // Billing Address
    "billingAddress__line1",
    "billingAddress__line2",
    "billingAddress__city",
    "billingAddress__state",
    "billingAddress__postalCode",
    "billingAddress__country",

    // Sales Tax
    "salesTaxCode__fullName",
    "salesTaxCode__id",

    "salesTaxItem__fullName",
    "salesTaxItem__id",

    // Lines (array → UNNEST)
    "lines__id",
    "lines__description",
    "lines__amount",
    "lines__rate",
    "lines__quantity",

    "lines__class__fullName",
    "lines__class__id",

    "lines__item__fullName",
    "lines__item__id",

    "lines__salesTaxCode__fullName",
    "lines__salesTaxCode__id"
  ];

  const select_sql = buildJsonSelect(columns);

  const raw_dataset = dataform.projectConfig.vars.raw_dataset;
}

WITH base AS (
  SELECT
    raw_payload,
    _extracted_at,
    JSON_QUERY_ARRAY(raw_payload, '$.lines') AS lines
  FROM ${ref(raw_dataset,"sales_receipts")}
  WHERE JSON_VALUE(raw_payload, '$.id') IS NOT NULL
  ${inc(ctx)}
),

flattened AS (
  SELECT
    raw_payload,
    _extracted_at,
    l AS lines
  FROM base,
  UNNEST(IFNULL(lines, [])) AS l
)

SELECT
  ${select_sql},
  _extracted_at
FROM flattened