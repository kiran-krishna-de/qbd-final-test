config {
  type: "incremental",
  schema: dataform.projectConfig.vars.bronze_dataset,
  tags: ["bronze", "purchase_orders"],
  uniqueKey: ["id","lines__id"],
  description: "Flat purchase orders table parsed from raw_payload JSON. Nested fields use __ separator."
}

js {
  const { buildJsonSelect } = require("../../includes/helpers.js");
  const { inc } = require("../../includes/helpers.js");

  const columns = [
    // Top-level
    "id",
    "refNumber",
    "transactionDate",
    "dueDate",
    "expectedDate",
    "createdAt",
    "updatedAt",
    "objectType",
    "revisionNumber",
    "memo",
    "totalAmount",

    "isFullyReceived",
    "isManuallyClosed",
    "isQueuedForEmail",
    "isQueuedForPrint",

    // Class
    "class__fullName",
    "class__id",

    // Vendor
    "vendor__fullName",
    "vendor__id",

    // Ship To
    "shipToEntity__fullName",
    "shipToEntity__id",

    // Terms
    "terms__fullName",
    "terms__id",

    // Document Template
    "documentTemplate__fullName",
    "documentTemplate__id",

    // Shipping Address
    "shippingAddress__line1",
    "shippingAddress__line2",
    "shippingAddress__city",
    "shippingAddress__state",
    "shippingAddress__postalCode",
    "shippingAddress__country",

    // Vendor Address
    "vendorAddress__line1",
    "vendorAddress__line2",
    "vendorAddress__line3",
    "vendorAddress__city",
    "vendorAddress__state",
    "vendorAddress__postalCode",
    "vendorAddress__country",

    // Lines (array → UNNEST)
    "lines__id",
    "lines__description",
    "lines__amount",
    "lines__rate",
    "lines__quantity",
    "lines__receivedQuantity",
    "lines__isBilled",
    "lines__isManuallyClosed",

    "lines__class__fullName",
    "lines__class__id",

    "lines__item__fullName",
    "lines__item__id",

    "lines__payee__fullName",
    "lines__payee__id"
  ];

  const select_sql = buildJsonSelect(columns);

  const raw_dataset = dataform.projectConfig.vars.raw_dataset;
}

WITH base AS (
  SELECT
    raw_payload,
    _extracted_at,
    JSON_QUERY_ARRAY(raw_payload, '$.lines') AS lines
  FROM ${ref(raw_dataset,"purchase_orders")}
  WHERE JSON_VALUE(raw_payload, '$.id') IS NOT NULL
  ${inc(ctx)}
),

flattened AS (
  SELECT
    raw_payload,
    _extracted_at,
    l AS lines
  FROM base,
  UNNEST(IFNULL(lines, [])) AS l
)

SELECT
  ${select_sql},
  _extracted_at
FROM flattened