config {
  type: "incremental",
  schema: "bronze",
  tags: ["bronze", "sales_tax_codes"],
  uniqueKey: ["id"],
  description: "Flat sales tax codes table parsed from raw_payload JSON."
}

js {
  const { buildJsonSelect } = require("../../includes/helpers.js");

  const { inc } = require("../../includes/helpers.js");

  const columns = [
    "createdAt",
    "description",
    "id",
    "isActive",
    "isTaxable",
    "name",
    "objectType",
    "revisionNumber",
    "updatedAt",
    "salesTaxItem"
  ];

  const select_sql = buildJsonSelect(columns);

  const raw_dataset = dataform.projectConfig.vars.raw_dataset;
}

SELECT
  ${select_sql},
  _extracted_at
FROM ${ref(raw_dataset,"sales_tax_codes")}
WHERE JSON_VALUE(raw_payload, '$.id') IS NOT NULL
${inc(ctx)}