config {
  type: "incremental",
  schema: dataform.projectConfig.vars.bronze_dataset,
  tags: ["bronze", "bills", "expense_lines"],
  uniqueKey: ["id"],
  description: "Flat bill expense lines table parsed from raw_payload JSON. Nested fields use __ separator."
}

js {
  const { buildJsonSelect } = require("../../includes/helpers.js");

  const { inc } = require("../../includes/helpers.js");

  // Flat fields — single underscore in name is preserved as-is in the JSON path
  // Nested fields — use double underscore (__) to map to dot notation in JSON
  //   e.g. account__id → JSON_VALUE(raw_payload, '$.account.id')
  const columns = [
    "id",                           // parent bill id
    "amount",
    "balanceRemaining",
    "transactionId",
    "transactionType",
    "transactionDate",
    "refNumber",
    "memo",
    "objectType",
    "account__id",
    "account__fullName",
    "class__id",
    "class__fullName",
    "payee__id",
    "payee__fullName"
  ];

  const select_sql = buildJsonSelect(columns);

  const raw_dataset = dataform.projectConfig.vars.raw_dataset;
}

SELECT
  ${select_sql},
  _extracted_at,
  JSON_VALUE(raw_payload,'$.updatedAt') as updatedAt
FROM ${ref(raw_dataset,"bills")},
UNNEST(JSON_QUERY_ARRAY(raw_payload, '$.expenseLines')) AS t
WHERE JSON_VALUE(raw_payload, '$.id') IS NOT NULL
${inc(ctx)}