config {
  type: "incremental",
  schema: "qdb_bronze",
  tags: ["bronze", "service_items"],
  uniqueKey: ["id"],
  description: "Flat service items table parsed from raw_payload JSON. Nested fields use __ separator."
}

js {
  const { buildJsonSelect } = require("../../includes/helpers.js");

  const { inc } = require("../../includes/helpers.js");

  const columns = [
    "barcode",
    "class",
    "createdAt",
    "externalId",
    "fullName",
    "id",
    "isActive",
    "name",
    "objectType",
    "parent",
    "revisionNumber",
    "salesAndPurchaseDetails",
    "sublevel",
    "unitOfMeasureSet",
    "updatedAt",

    // Nested: salesOrPurchaseDetails
    "salesOrPurchaseDetails__description",
    "salesOrPurchaseDetails__price",
    "salesOrPurchaseDetails__pricePercentage",

    // Nested: salesOrPurchaseDetails.postingAccount
    "salesOrPurchaseDetails__postingAccount__id",
    "salesOrPurchaseDetails__postingAccount__fullName",

    // Nested: salesTaxCode
    "salesTaxCode__id",
    "salesTaxCode__fullName"
  ];

  const select_sql = buildJsonSelect(columns);
}

SELECT
  ${select_sql},
  _extracted_at
FROM ${ref("qdb_new","service_items")}
WHERE JSON_VALUE(raw_payload, '$.id') IS NOT NULL
${inc(ctx)}