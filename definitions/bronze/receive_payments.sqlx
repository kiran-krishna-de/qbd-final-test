config {
  type: "incremental",
  schema: dataform.projectConfig.vars.bronze_dataset,
  tags: ["bronze", "receive_payments"],
  uniqueKey: ["id","appliedToTransactions__transactionId"],
  description: "Flat receive payments table parsed from raw_payload JSON. Nested fields use __ separator."
}

js {
  const { buildJsonSelect } = require("../../includes/helpers.js");
  const { inc } = require("../../includes/helpers.js");

  const columns = [
    // Top-level
    "id",
    "refNumber",
    "transactionDate",
    "createdAt",
    "updatedAt",
    "objectType",
    "revisionNumber",
    "memo",
    "totalAmount",
    "unusedCredits",
    "unusedPayment",

    // Customer
    "customer__fullName",
    "customer__id",

    // Deposit account
    "depositToAccount__fullName",
    "depositToAccount__id",

    // Receivables account
    "receivablesAccount__fullName",
    "receivablesAccount__id",

    // Payment method
    "paymentMethod__fullName",
    "paymentMethod__id",

    // Applied transactions (array → UNNEST)
    "appliedToTransactions__transactionId",
    "appliedToTransactions__transactionType",
    "appliedToTransactions__refNumber",
    "appliedToTransactions__transactionDate",
    "appliedToTransactions__amount",
    "appliedToTransactions__balanceRemaining",
    "appliedToTransactions__discountAmount"
  ];

  const select_sql = buildJsonSelect(columns);

  const raw_dataset = dataform.projectConfig.vars.raw_dataset;
}

WITH base AS (
  SELECT
    raw_payload,
    _extracted_at,
    JSON_QUERY_ARRAY(raw_payload, '$.appliedToTransactions') AS appliedToTransactions
  FROM ${ref(raw_dataset,"receive_payments")}
  WHERE JSON_VALUE(raw_payload, '$.id') IS NOT NULL
  ${inc(ctx)}
),

flattened AS (
  SELECT
    raw_payload,
    _extracted_at,
    l AS appliedToTransactions
  FROM base,
  UNNEST(IFNULL(appliedToTransactions, [])) AS l
)

SELECT
  ${select_sql},
  _extracted_at
FROM flattened