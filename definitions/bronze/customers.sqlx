config {
  type: "incremental",
  schema: "bronze",
  tags: ["bronze", "customers"],
  uniqueKey: ["id"],
  description: "Flat customers table parsed from raw_payload JSON. Nested fields use __ separator."
}



js {
  const { buildJsonSelect } = require("../../includes/helpers.js");

  const { inc } = require("../../includes/helpers.js")

  // Flat + nested fields
  const columns = [
    "accountNumber",
    "alternateContact",
    "alternatePhone",
    "balance",
    "ccEmail",
    "class",
    "companyName",
    "contact",
    "createdAt",
    "creditCard",
    "creditLimit",
    "currency",
    "customerType",
    "email",
    "externalId",
    "fax",
    "firstName",
    "fullName",
    "id",
    "isActive",
    "jobDescription",
    "jobEndDate",
    "jobProjectedEndDate",
    "jobStartDate",
    "jobStatus",
    "jobTitle",
    "jobType",
    "lastName",
    "middleName",
    "name",
    "note",
    "objectType",
    "parent",
    "phone",
    "preferredDeliveryMethod",
    "preferredPaymentMethod",
    "priceLevel",
    "resaleNumber",
    "revisionNumber",
    "salesRepresentative",
    "salesTaxCountry",
    "salutation",
    "shippingAddress",
    "sublevel",
    "taxRegistrationNumber",
    "terms",
    "totalBalance",
    "updatedAt",

    // Nested: billingAddress
    "billingAddress__city",
    "billingAddress__country",
    "billingAddress__line1",
    "billingAddress__line2",
    "billingAddress__line3",
    "billingAddress__line4",
    "billingAddress__line5",
    "billingAddress__note",
    "billingAddress__postalCode",
    "billingAddress__state",

    // Nested: salesTaxCode
    "salesTaxCode__id",
    "salesTaxCode__fullName",

    // Nested: salesTaxItem
    "salesTaxItem__id",
    "salesTaxItem__fullName"
  ];

  const select_sql = buildJsonSelect(columns);

  const raw_dataset = dataform.projectConfig.vars.raw_dataset;

}

SELECT
  ${select_sql},
  _extracted_at
FROM ${ref(raw_dataset,"customers")}
WHERE JSON_VALUE(raw_payload, '$.id') IS NOT NULL
${inc(ctx)}