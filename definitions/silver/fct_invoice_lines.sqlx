config {
  type: "table",
  schema: dataform.projectConfig.vars.silver_dataset,
  name: "fct_invoice_lines",
  tags: ["silver", "facts"],
  description: "Silver: invoice line items",
  bigquery: {
    partitionBy: "transaction_date",
    clusterBy: ["invoice_id", "item_id"]
  }
}

WITH deduped AS (
  SELECT *,
    ROW_NUMBER() OVER (
      PARTITION BY id, lines__id
      ORDER BY _extracted_at DESC
    ) AS _row_num
  FROM ${ref(dataform.projectConfig.vars.bronze_dataset, "invoices")}
  WHERE id IS NOT NULL AND lines__id IS NOT NULL
)
SELECT
  id                                              AS invoice_id,
  lines__id                                       AS line_id,
  SAFE.PARSE_DATE('%Y-%m-%d', transactionDate)    AS transaction_date,
  customer__id                                    AS customer_id,
  class__id                                       AS class_id,
  TRIM(class__fullName)                           AS class_name,
  lines__item__id                                 AS item_id,
  TRIM(lines__item__fullName)                     AS item_name,
  TRIM(lines__description)                        AS line_description,
  SAFE_CAST(lines__amount AS NUMERIC)             AS line_amount,
  SAFE_CAST(lines__rate AS NUMERIC)               AS unit_rate,
  SAFE_CAST(lines__quantity AS NUMERIC)           AS quantity,
  CAST(_extracted_at AS TIMESTAMP)               AS _extracted_at
FROM deduped
WHERE _row_num = 1
